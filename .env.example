# Copy to .env.local and fill in.

# Canonical site URL — used for <link rel="canonical">, og:url and the sitemap.
# On Vercel you can leave this unset; it falls back to the value in the code.
NEXT_PUBLIC_SITE_URL=

# Web3Forms access key (https://web3forms.com) — enables the contact form.
# Get a free key by entering your email on their site. Leave blank to disable the form.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
